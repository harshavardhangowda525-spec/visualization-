NODE_ENV=development
DATABASE_URL=postgresql://studio:local-development-only@localhost:5432/studio
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
OTP_PEPPER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
S3_MEDIA_BUCKET=
MEDIA_CDN_URL=
SES_FROM_EMAIL=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_DLT_TEMPLATE_ID=
BUSINESS_TIMEZONE=Asia/Kolkata

# Render preview launcher (the Blueprint configures these automatically).
# Do not enable preview seeding or startup migrations for a production release.
DEPLOYMENT_ENV=development
RUN_DATABASE_MIGRATIONS=false
SEED_PREVIEW_CATALOGUE=false
ENABLE_MAINTENANCE_WORKER=false
API_BIND_HOST=0.0.0.0

# For AWS provider access when hosted outside AWS, use an approved least-privilege identity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Vercel scheduled maintenance: separate securely generated secret, 32+ characters.
CRON_SECRET=
