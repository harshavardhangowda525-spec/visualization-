{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm ci --include=dev",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "server.cjs",
      "installCommand": "cd ../.. && npm ci --include=dev",
      "buildCommand": "cd ../.. && npm run db:generate && npm run build -w apps/api"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/v1/internal/maintenance", "schedule": "* * * * *" }]
}
